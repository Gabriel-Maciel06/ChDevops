						},
						"url": "http://localhost:8080/api/clinicas"
					}
				},
				{
					"name": "Cadastrar Especialista",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Dr. Anderson\",\n    \"especialidade\": \"NEURO\"\n}"
						},
						"url": "http://localhost:8080/api/especialistas"
					}
				}
			]
		},
		{
			"name": "Eventos e Histórico",
			"item": [
				{
					"name": "Registrar Evento (Consulta)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tipo\": \"CONSULTA ESPECIALISTA\",\n    \"pet\": { \"id\": 1 },\n    \"tutor\": { \"cpf\": \"12345678900\" },\n    \"medico\": { \"id\": 1 }\n}"
						},
						"url": "http://localhost:8080/api/eventos"
					}
				}
			]
		},
		{
			"name": "Match Preditivo & Geolocalização",
			"item": [
				{
					"name": "Sugerir Clínicas Próximas (Match Preditivo)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8080/api/match-preditivo/clinicas?cpfTutor=12345678900&idTipoServico=1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "match-preditivo", "clinicas"],
							"query": [
								{ "key": "cpfTutor", "value": "12345678900" },
								{ "key": "idTipoServico", "value": "1" }
