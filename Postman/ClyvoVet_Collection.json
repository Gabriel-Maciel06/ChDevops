{
	"info": {
		"name": "Clyvo Vet - Challenge API",
		"description": "Collection completa para testes do ecossistema Clyvo Vet (Java Advanced)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Pets",
			"item": [
				{
					"name": "Listar Pets (Paginação)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8080/api/pets?page=0&size=5",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "pets"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "5" }
							]
						}
					}
				},
				{
					"name": "Buscar Pet por ID (HATEOAS)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/pets/1"
					}
				}
			]
		},
		{
			"name": "Tutores",
			"item": [
				{
					"name": "Trocar Pet (Listar por CPF)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/tutores/12345678900/pets"
					}
				}
			]
		},
		{
			"name": "Clínica & Especialistas",
			"item": [
