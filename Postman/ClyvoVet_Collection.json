						"body": {
							"mode": "raw",
							"raw": "{\n    \"tutor\": { \"cpf\": \"12345678900\" },\n    \"latitudeAtual\": -23.563000,\n    \"longitudeAtual\": -46.654000,\n    \"dataHoraCaptura\": \"2026-05-18T10:00:00\",\n    \"cidadeDetectada\": \"São Paulo\"\n}"
						},
						"url": "http://localhost:8080/api/contexto-localizacao"
